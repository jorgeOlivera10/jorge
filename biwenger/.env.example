# =============================================================================
# Configuración de biwenger-analyzer — COPIA este fichero a .env y rellénalo.
# El fichero .env está en .gitignore: NUNCA se sube al repositorio.
# =============================================================================

# --- Credenciales de login (Biwenger) ---
# Tu email y contraseña de Biwenger. Se usan SOLO para hacer login y obtener
# el token Bearer. No se guardan en la base de datos.
BIWENGER_EMAIL=tu-email@ejemplo.com
BIWENGER_PASSWORD=tu-password

# --- Cabeceras que debes capturar desde el navegador ---
# Cómo capturarlas (ver README, sección "Cómo capturar mis cabeceras"):
#   1. Entra a https://biwenger.as.com con tu liga abierta.
#   2. Abre DevTools (F12) -> pestaña "Network".
#   3. Recarga y pincha en cualquier petición a "cf.biwenger.com".
#   4. En "Request Headers" copia los valores de X-User, X-League y X-Version.
BIWENGER_USER_ID=          # cabecera X-User (captúrala del navegador, tal cual)
BIWENGER_LEAGUE_ID=1981505 # cabecera X-League (liga Pain&Gain)
BIWENGER_VERSION=          # cabecera X-Version (p. ej. 631; captúrala del navegador)

# --- Nombre de tu liga (solo informativo, para los informes) ---
BIWENGER_LEAGUE_NAME=Pain&Gain

# --- Sistemas de puntuación (parámetro ?score= de la API) ---
# Tu liga puntúa con Picas del AS (scoreID=5). El id de Sofascore hay que
# verificarlo con 'biwenger verify' y ajustarlo aquí si no coincide.
BIWENGER_SCORE_SOFASCORE=1
BIWENGER_SCORE_AS=5
# Sistema por defecto para los informes: la liga usa "as".
BIWENGER_SCORE_DEFAULT=as

# --- Economía de la liga ---
# Presupuesto inicial de cada manager al empezar la liga (en euros de Biwenger).
BIWENGER_INITIAL_BUDGET=40000000
# Coeficiente sobre el valor de equipo para la puja máxima:
#   puja_maxima = saldo_estimado + BID_TEAM_VALUE_FACTOR * valor_equipo
BIWENGER_BID_TEAM_VALUE_FACTOR=0.25

# --- Persistencia ---
# Ruta del fichero SQLite. Relativa a la raíz del proyecto biwenger/.
DATABASE_URL=sqlite:///data/biwenger.db

# --- Red / rate limit ---
# Segundos mínimos entre peticiones a la API (throttling anti-baneo).
BIWENGER_MIN_REQUEST_INTERVAL=1.0
# Segundos de validez de la caché en disco para respuestas GET.
BIWENGER_CACHE_TTL=3600
# Reintentos ante errores de red / 5xx.
BIWENGER_MAX_RETRIES=4

# --- Logging ---
LOG_LEVEL=INFO
